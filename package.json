{
  "name": "@ankhorage/templates",
  "version": "7.0.0",
  "description": "Reusable Ankhorage app templates, presets, and manifest generators.",
  "homepage": "https://github.com/ankhorage/templates#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/templates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/templates.git"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "typescript",
    "templates",
    "app-templates",
    "manifest",
    "app-generator",
    "react-native",
    "expo",
    "supabase",
    "vault",
    "secret-store"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ankhorage-templates": "./dist/cli/standalone.js"
  },
  "ankh": {
    "category": "templates",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      "templates.list",
      "templates.inspect",
      "templates.create"
    ]
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "bunx @ankhorage/paradox@0.1.16 && ankhorage-prettier --write docs README.md",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit && bun x tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build && bun test",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/contracts": "^8.0.0",
    "@ankhorage/zora": "^2.11.0"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.8.8",
    "@ankhorage/devtools": "^1.9.4",
    "@ankhorage/doctor": "^0.10.6",
    "@ankhorage/paradox": "^0.1.16",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.0"
}
