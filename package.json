{
  "name": "@ankhorage/templates",
  "version": "1.3.1",
  "description": "Reusable Ankhorage app templates, presets, and manifest generators.",
  "homepage": "https://github.com/ankhorage/templates#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/templates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/templates.git"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "typescript",
    "templates",
    "app-templates",
    "manifest",
    "app-generator",
    "react-native",
    "expo"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun x tsc -p tsconfig.json",
    "knip": "ankhorage-knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --max-warnings=0 --fix",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit && bun x tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build && bun test",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@ankhorage/contracts": "^1.14.0",
    "@ankhorage/zora": "^2.6.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.0.6",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.13"
}
