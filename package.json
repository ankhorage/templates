{
  "name": "@ankhorage/templates",
  "version": "12.7.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/templates.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@ankhorage/ankh": "^0.13.7",
    "@ankhorage/devtools": "^2.11.3",
    "@ankhorage/doctor": "^0.15.21",
    "@ankhorage/paradox": "^0.6.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json",
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    }
  },
  "ankh": {
    "category": "templates",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "templates.list",
        "owner": "@ankhorage/templates",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "templates.inspect",
        "owner": "@ankhorage/templates",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "templates.create",
        "owner": "@ankhorage/templates",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      }
    ]
  },
  "bin": {
    "ankhorage-templates": "./dist/cli/standalone.js"
  },
  "bugs": {
    "url": "https://github.com/ankhorage/templates/issues"
  },
  "description": "Portable Ankhorage app templates, presets, and manifest authoring helpers.",
  "files": [
    "dist",
    "src/templates/categories/**/assets/**",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/ankhorage/templates#readme",
  "keywords": [
    "ankhorage",
    "app-generator",
    "app-templates",
    "expo",
    "manifest",
    "react-native",
    "secret-store",
    "supabase",
    "templates",
    "typescript",
    "vault"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "templates:catalog": "bun .agents/skills/zora-designer/scripts/generate-template-catalog.ts .",
    "build": "bun run templates:catalog && bun x tsc -p tsconfig.json && bun build src/index.ts --target node --format esm --outdir dist",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "bunx @ankhorage/paradox@0.1.16 && ankhorage-prettier --write docs README.md",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit && bun x tsc -p tsconfig.test.json --noEmit",
    "test": "bun test --path-ignore-patterns 'test/grossmeister.chromium.test.ts' && bun run test:packed-consumer",
    "test:chromium": "bun test ./test/grossmeister.chromium.test.ts",
    "test:packed-consumer": "bun run build && bun test ./test/packedConsumer.ts",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip",
    "test:standalone": "bun test test/root-exports.test.ts test/commands.test.ts"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@ankhorage/capability": "^0.2.3",
    "@ankhorage/color-theory": "^0.3.4",
    "@ankhorage/contracts": "^26.17.1",
    "@ankhorage/data-sources": "^2.4.0",
    "@ankhorage/navigator": "^3.6.7",
    "@ankhorage/runtime": "^5.6.4",
    "@ankhorage/utility": "^1.11.0",
    "@ankhorage/zora": "^28.0.0"
  }
}
