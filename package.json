{
  "name": "@ankhorage/templates",
  "version": "12.0.143",
  "description": "Portable Ankhorage app templates, presets, and manifest authoring helpers.",
  "homepage": "https://github.com/ankhorage/templates#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/templates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/templates.git"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ankhorage",
    "app-generator",
    "app-templates",
    "expo",
    "manifest",
    "react-native",
    "secret-store",
    "supabase",
    "templates",
    "typescript",
    "vault"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "src/templates/categories/**/assets/**",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json",
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ankhorage-templates": "./dist/cli/standalone.js"
  },
  "ankh": {
    "category": "templates",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "templates.list",
        "owner": "@ankhorage/templates",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "templates.inspect",
        "owner": "@ankhorage/templates",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "templates.create",
        "owner": "@ankhorage/templates",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      }
    ]
  },
  "scripts": {
    "templates:catalog": "bun .agents/skills/zora-designer/scripts/generate-template-catalog.ts .",
    "build": "bun run templates:catalog && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "bunx @ankhorage/paradox@0.1.16 && ankhorage-prettier --write docs README.md",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "typecheck": "bun run templates:catalog && bun x tsc -p tsconfig.json --noEmit && bun x tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build && bun test",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip",
    "test:standalone": "bun test test/root-exports.test.ts test/commands.test.ts"
  },
  "dependencies": {
    "@ankhorage/color-theory": "^0.3.1",
    "@ankhorage/contracts": "^24.2.1",
    "@ankhorage/navigator": "^3.5.2",
    "@ankhorage/zora": "^24.1.2"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.12.2",
    "@ankhorage/devtools": "^2.3.9",
    "@ankhorage/doctor": "^0.14.5",
    "@ankhorage/paradox": "^0.3.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
